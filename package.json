{
	"name": "@egkike/pi-streambeats",
	"version": "0.0.0",
	"description": "Play your local music library from Pi and Gentle Shell — a browse-and-play card powered by mpv.",
	"type": "module",
	"license": "MIT",
	"author": "Enrique Garcia",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/egkike/pi-streambeats.git"
	},
	"homepage": "https://github.com/egkike/pi-streambeats#readme",
	"bugs": {
		"url": "https://github.com/egkike/pi-streambeats/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"gentle-shell",
		"music",
		"player",
		"mpv",
		"streambeats",
		"tui"
	],
	"files": [
		"extensions/",
		"lib/"
	],
	"engines": {
		"node": ">=22.19"
	},
	"packageManager": "pnpm@12.18.0",
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"scripts": {
		"test": "node --test 'tests/*.test.ts'",
		"typecheck": "tsc -p .",
		"lint": "biome ci",
		"format": "biome format --write",
		"check": "pnpm lint && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^22",
		"typescript": "^7.0.2"
	}
}
